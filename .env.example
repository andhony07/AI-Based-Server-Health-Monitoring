# ==============================================================================
# AI-Based Predictive System Health Monitoring and Failure Risk Analysis
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env and modify values as needed for your local environment:
#   copy .env.example .env (Windows)
#   cp .env.example .env (Linux/macOS)

# Application Metadata
APP_NAME="AI-Based Predictive System Health Monitoring"
APP_ENV=development

# Logging Settings
# Supported levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Metric Collection Settings (seconds between sampling intervals)
METRIC_COLLECTION_INTERVAL=5.0

# Process Telemetry Limits (top N processes by resource utilization)
MAX_PROCESSES=10

# Optional CPU Sampling Interval (leave unset or empty for non-blocking sampling)
# CPU_SAMPLE_INTERVAL=0.1

# Preprocessing & Feature Engineering Settings (Phase 3)
ROLLING_WINDOW_SIZE=12
MAX_HISTORY_SIZE=60
MISSING_VALUE_STRATEGY=zero

# Database Persistence Settings (Phase 4)
# DB_PATH=system_metrics.db
# DB_CONNECTION_TIMEOUT=30.0
# DB_AUTO_INIT=true
# Optional retention threshold in days (purges older telemetry if set)
# DB_RETENTION_DAYS=30

# Machine Learning & Failure Risk Settings (Phase 5)
# ML_ISOLATION_FOREST_N_ESTIMATORS=100
# ML_ISOLATION_FOREST_CONTAMINATION=0.05
# ML_RANDOM_SEED=42
# ML_MIN_TRAINING_SAMPLES=20
# ML_RISK_THRESHOLD_LOW=0.35
# ML_RISK_THRESHOLD_MODERATE=0.55
# ML_RISK_THRESHOLD_HIGH=0.75
# ML_RISK_THRESHOLD_CRITICAL=0.90

# Interactive Web Dashboard Settings (Phase 6)
# DASHBOARD_REFRESH_INTERVAL=5
# DASHBOARD_HISTORICAL_LIMIT=500
# DASHBOARD_PORT=8501

# Optional Directory Overrides (defaults to project-relative paths if unset)
# DATA_DIR=data
# MODELS_DIR=models
# LOGS_DIR=logs


